# ============================================================
# AI Workflow Builder — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Database (PostgreSQL) ---
# Install PostgreSQL locally: https://www.postgresql.org/download/windows/
# Create a database called workflow_builder before first run.
# Example: createdb -U postgres workflow_builder
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/workflow_builder

# --- LLM Configuration ---
# Options: gemini | openai | mock
LLM_PROVIDER=gemini

# Gemini (recommended) — get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI (alternative)
OPENAI_API_KEY=your_openai_api_key_here

# --- Embeddings ---
# Options: gemini | openai | mock
# Leave unset to automatically match LLM_PROVIDER.
# EMBEDDING_PROVIDER=gemini

# --- ChromaDB (embedded persistent storage — no server needed) ---
# ChromaDB will store its data in this local directory.
CHROMA_PERSIST_DIR=./chroma_data
ANONYMIZED_TELEMETRY=False

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- File Uploads ---
UPLOAD_DIR=./uploads

# --- Development ---
DEBUG=true
